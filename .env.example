# ============================================
# Mail Redirector - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# IMAP Configuration (Required)
# ============================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_TLS=true

# ============================================
# SMTP Configuration (Required)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=false

# ============================================
# Email Forwarding Settings
# ============================================
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Mail Redirector

# ============================================
# IMAP Retry Settings
# ============================================
# Maximum number of retry attempts for IMAP connection
MAX_RETRY_ATTEMPTS=10
# Base delay in milliseconds for exponential backoff
BASE_RETRY_DELAY=5000
# Maximum delay in milliseconds (5 minutes)
MAX_RETRY_DELAY=300000

# ============================================
# SMTP Retry Settings
# ============================================
# Maximum number of retry attempts for SMTP sending
SMTP_MAX_RETRY_ATTEMPTS=3
# Base delay in milliseconds for SMTP exponential backoff
SMTP_BASE_RETRY_DELAY=2000
# Maximum delay in milliseconds for SMTP retries
SMTP_MAX_RETRY_DELAY=30000

# ============================================
# Email Processing Settings
# ============================================
# Email check interval in milliseconds (default: 30000 = 30 seconds)
CHECK_INTERVAL=30000
# Process only unread emails (true/false)
ONLY_UNREAD=false
# Monitor spam folder (true/false)
MONITOR_SPAM=false
# Spam folder name (varies by provider: [Gmail]/Spam, Junk Email, SPAM, etc.)
SPAM_FOLDER_NAME="[Gmail]/Spam
EOF"

# ============================================
# Logging Configuration
# ============================================
# Log level: error, warn, info, debug
LOG_LEVEL=info
# Maximum size of log file (e.g., 20m, 100m)
LOG_MAX_SIZE=20m
# How long to keep log files (e.g., 14d, 30d, 7d)
LOG_MAX_FILES=14d
# Compress old log files (true/false)
LOG_ZIP_ARCHIVE=false

# ============================================
# API Configuration
# ============================================
# Enable/disable REST API server (true/false)
API_ENABLED=true
# API server port number
API_PORT=3000

# ============================================
# Application Environment
# ============================================
# Environment: development, production, test
NODE_ENV=production

# Report Configuration
REPORT_RECIPIENTS=admin@company.com
REPORT_DAILY_ENABLED=true
REPORT_DAILY_SCHEDULE=0 9 * * *
REPORT_WEEKLY_ENABLED=true
REPORT_WEEKLY_SCHEDULE=0 9 * * 1
REPORT_TIMEZONE=Europe/Istanbul
